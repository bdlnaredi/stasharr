<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="stasharr_bg">#0B0B10</color>
    <color name="ic_launcher_background">#0B0B10</color>

    <style name="Theme.Stasharr" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/stasharr_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Stasharr.Player" parent="Theme.Stasharr">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
